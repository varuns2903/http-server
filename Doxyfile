PROJECT_NAME           = "Orbit Framework"
PROJECT_BRIEF          = "An ultra-modern, asynchronous, cross-platform C++ Web Framework."
OUTPUT_DIRECTORY       = docs
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO

# Input settings
INPUT                  = include/orbit src README.md
USE_MDFILE_AS_MAINPAGE = README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp
EXCLUDE_PATTERNS       = */third_party/*

# HTML Settings
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_TIMESTAMP         = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# Warning settings
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO

# C++ Settings
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
